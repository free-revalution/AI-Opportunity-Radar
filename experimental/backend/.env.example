# =================================================================
# AI Opportunity Radar — PRE-MVP / FREEZE surface env vars.
#
# These vars powered the v1.x subscriptions / activation /
# content-radar / multi-channel-fallback layers. The MVP no longer
# reads them (see the root `.env.example` for the active surface) but
# the experimental code in this directory still references them, so
# the variables are preserved here for reference and for reviving
# any FREEZE feature.
#
# Copy to `experimental/backend/.env` if you intend to run the
# experimental code path.
# =================================================================


# ---------- Alternative LLM providers (pre-MVP) ----------
OPENAI_API_KEY=
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_MID=gpt-4o
OPENAI_MODEL_STRONG=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
ANTHROPIC_MODEL_MID=claude-sonnet-5
ANTHROPIC_MODEL_STRONG=claude-opus-5

GEMINI_API_KEY=
GEMINI_MODEL_CHEAP=gemini-1.5-flash
GEMINI_MODEL_MID=gemini-1.5-pro
GEMINI_MODEL_STRONG=gemini-1.5-pro


# ---------- Telegram (FREEZE notification channel) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=


# ---------- Feishu content ecosystem (FREEZE — Docx + Bitable) ----------
# Drive folder for `/research` and `/report` Docx creation.
FEISHU_DRIVE_ROOT_FOLDER_TOKEN=
# Bitable table for `/daily`.
FEISHU_BITABLE_APP_TOKEN=
# Bitable table for `/table`.
FEISHU_BITABLE_OPPORTUNITIES_APP_TOKEN=


# ---------- Notification fallback (FREEZE) ----------
NOTIFICATION_DEFAULT_CHANNEL=feishu
NOTIFICATION_FALLBACK_CHANNELS=telegram


# ---------- Backups (FREEZE) ----------
BACKUP_CONTAINER_NAME=radar-postgres
BACKUP_OUTPUT_DIR=./backups


# ---------- Redis result backend (FREEZE — RQ worker retired) ----------
REDIS_RESULT_BACKEND=redis://redis:6379/1


# ---------- Deep Research extras (FREEZE deep-research surface) ----------
DEEP_RESEARCH_MAX_TOKENS=50000


# ---------- Phase 23 — auto-send activation code + renewal reminders (FREEZE) ----------
SEND_ACTIVATION_CODE_VIA_IM=true
SUBSCRIPTION_RENEWAL_REMINDER_ENABLED=true
SUBSCRIPTION_RENEWAL_REMINDER_DAYS=3
SUBSCRIPTION_RENEWAL_REMINDER_COOLDOWN_HOURS=24


# ---------- Phase 24 — Compliance Engine wiring (FREEZE) ----------
COMPLIANCE_PRE_SEND_GATE_ENABLED=true
COMPLIANCE_SOURCE_GATE_ENABLED=true