{
  "name": "feishu-daily-digest",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "30 0 * * *" }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Cron (daily 02:30 UTC, after discovery)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL_INTERNAL}}/api/internal/notifications/digest/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Radar-Webhook", "value": "={{$env.APP_SECRET_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"channel\": \"feishu\", \"max_entries\": 5, \"min_score\": 0}",
        "options": {
          "timeout": 300000,
          "retry": { "maxTries": 2, "waitBetweenTries": 5000 }
        }
      },
      "id": "step-feishu-send",
      "name": "Send Feishu digest (Phase 6 unified endpoint)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    }
  ],
  "connections": {
    "Cron (daily 02:30 UTC, after discovery)": {
      "main": [
        [
          { "node": "Send Feishu digest (Phase 6 unified endpoint)", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}