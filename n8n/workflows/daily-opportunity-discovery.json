{
  "name": "daily-opportunity-discovery",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "cronExpression",
              "expression": "0 0 * * *",
              "timezone": "UTC"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Cron (daily 02:00 UTC)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL_INTERNAL}}/api/internal/discovery/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Radar-Webhook", "value": "={{$env.RADAR_WEBHOOK_SECRET}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"sources\": [\"github\",\"reddit\",\"hackernews\",\"producthunt\",\"rss\"]}",
        "options": {
          "timeout": 600000,
          "retry": { "maxTries": 3, "waitBetweenTries": 5000 }
        }
      },
      "id": "step-discovery",
      "name": "1. Discovery (sources)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL_INTERNAL}}/api/internal/clustering/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Radar-Webhook", "value": "={{$env.RADAR_WEBHOOK_SECRET}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"raw_item_limit\": 500, \"threshold\": 0.82}",
        "options": {
          "timeout": 600000,
          "retry": { "maxTries": 2, "waitBetweenTries": 8000 }
        }
      },
      "id": "step-clustering",
      "name": "2. Clustering",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL_INTERNAL}}/api/internal/screening/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Radar-Webhook", "value": "={{$env.RADAR_WEBHOOK_SECRET}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"limit\": 50}",
        "options": {
          "timeout": 600000,
          "retry": { "maxTries": 2, "waitBetweenTries": 8000 }
        }
      },
      "id": "step-screening",
      "name": "3. Screening",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL_INTERNAL}}/api/internal/scoring/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Radar-Webhook", "value": "={{$env.RADAR_WEBHOOK_SECRET}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"limit\": 200, \"trigger_threshold\": 70}",
        "options": {
          "timeout": 300000,
          "retry": { "maxTries": 2, "waitBetweenTries": 8000 }
        }
      },
      "id": "step-scoring",
      "name": "4. Scoring",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL_INTERNAL}}/api/internal/research/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Radar-Webhook", "value": "={{$env.RADAR_WEBHOOK_SECRET}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"limit\": 10, \"max_urls\": 20}",
        "options": {
          "timeout": 1800000,
          "retry": { "maxTries": 1, "waitBetweenTries": 15000 }
        }
      },
      "id": "step-research",
      "name": "5. Deep Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL_INTERNAL}}/api/internal/notifications/digest/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Radar-Webhook", "value": "={{$env.RADAR_WEBHOOK_SECRET}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"max_entries\": 5, \"per_entry_summary_chars\": 240, \"min_score\": 70.0}",
        "options": {
          "timeout": 120000,
          "retry": { "maxTries": 2, "waitBetweenTries": 5000 }
        }
      },
      "id": "step-digest-send",
      "name": "6. Digest -> Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1920, 300]
    }
  ],
  "connections": {
    "Cron (daily 02:00 UTC)": {
      "main": [[{ "node": "1. Discovery (sources)", "type": "main", "index": 0 }]]
    },
    "1. Discovery (sources)": {
      "main": [[{ "node": "2. Clustering", "type": "main", "index": 0 }]]
    },
    "2. Clustering": {
      "main": [[{ "node": "3. Screening", "type": "main", "index": 0 }]]
    },
    "3. Screening": {
      "main": [[{ "node": "4. Scoring", "type": "main", "index": 0 }]]
    },
    "4. Scoring": {
      "main": [[{ "node": "5. Deep Research", "type": "main", "index": 0 }]]
    },
    "5. Deep Research": {
      "main": [[{ "node": "6. Digest -> Telegram", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "timezone": "UTC",
    "errorWorkflow": ""
  }
