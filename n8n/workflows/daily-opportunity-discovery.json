{
  "name": "full-pipeline-webhook",
  "active": true,
  "description": "Phase 25 v2.1 — full 6-step pipeline triggered by external webhook. Replaces the old cron-bound daily-opportunity-discovery workflow. The 08:00 Asia/Shanghai schedule lives in daily-pipeline-8am.json.",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "full-pipeline",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook (manual / external trigger)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "radar-full-pipeline"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL_INTERNAL}}/api/internal/discovery/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Radar-Webhook", "value": "={{$env.RADAR_WEBHOOK_SECRET}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json.body && $json.body.sources ? { sources: $json.body.sources } : { sources: [\"github\",\"reddit\",\"hackernews\",\"producthunt\",\"rss\",\"arxiv\",\"huggingface\",\"douyin\",\"weibo\",\"zhihu\",\"amazon_best\",\"wallstreetcn_hot\"] })}}",
        "options": {
          "timeout": 600000,
          "retry": { "maxTries": 3, "waitBetweenTries": 5000 }
        }
      },
      "id": "step-discovery",
      "name": "1. Discovery (sources)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL_INTERNAL}}/api/internal/clustering/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Radar-Webhook", "value": "={{$env.RADAR_WEBHOOK_SECRET}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"raw_item_limit\": 500, \"threshold\": 0.82}",
        "options": {
          "timeout": 600000,
          "retry": { "maxTries": 2, "waitBetweenTries": 8000 }
        }
      },
      "id": "step-clustering",
      "name": "2. Clustering",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL_INTERNAL}}/api/internal/screening/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Radar-Webhook", "value": "={{$env.RADAR_WEBHOOK_SECRET}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"limit\": 50}",
        "options": {
          "timeout": 600000,
          "retry": { "maxTries": 2, "waitBetweenTries": 8000 }
        }
      },
      "id": "step-screening",
      "name": "3. Screening",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL_INTERNAL}}/api/internal/scoring/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Radar-Webhook", "value": "={{$env.RADAR_WEBHOOK_SECRET}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"limit\": 200, \"trigger_threshold\": 70}",
        "options": {
          "timeout": 300000,
          "retry": { "maxTries": 2, "waitBetweenTries": 8000 }
        }
      },
      "id": "step-scoring",
      "name": "4. Scoring",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL_INTERNAL}}/api/internal/research/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Radar-Webhook", "value": "={{$env.RADAR_WEBHOOK_SECRET}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"limit\": 10, \"max_urls\": 20}",
        "options": {
          "timeout": 1800000,
          "retry": { "maxTries": 1, "waitBetweenTries": 15000 }
        }
      },
      "id": "step-research",
      "name": "5. Deep Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL_INTERNAL}}/api/internal/notifications/digest/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Radar-Webhook", "value": "={{$env.RADAR_WEBHOOK_SECRET}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json.body && $json.body.max_entries ? { max_entries: $json.body.max_entries, per_entry_summary_chars: 240, min_score: 70.0 } : { max_entries: 5, per_entry_summary_chars: 240, min_score: 70.0 })}}",
        "options": {
          "timeout": 120000,
          "retry": { "maxTries": 2, "waitBetweenTries": 5000 }
        }
      },
      "id": "step-digest-send",
      "name": "6. Digest -> Feishu",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1920, 300]
    }
  ],
  "connections": {
    "Webhook (manual / external trigger)": {
      "main": [[{ "node": "1. Discovery (sources)", "type": "main", "index": 0 }]]
    },
    "1. Discovery (sources)": {
      "main": [[{ "node": "2. Clustering", "type": "main", "index": 0 }]]
    },
    "2. Clustering": {
      "main": [[{ "node": "3. Screening", "type": "main", "index": 0 }]]
    },
    "3. Screening": {
      "main": [[{ "node": "4. Scoring", "type": "main", "index": 0 }]]
    },
    "4. Scoring": {
      "main": [[{ "node": "5. Deep Research", "type": "main", "index": 0 }]]
    },
    "5. Deep Research": {
      "main": [[{ "node": "6. Digest -> Feishu", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "timezone": "Asia/Shanghai",
    "errorWorkflow": ""
  }
}
