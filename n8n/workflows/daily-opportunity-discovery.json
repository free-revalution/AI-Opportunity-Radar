{
  "name": "daily-opportunity-discovery",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{}]
        }
      },
      "id": "cron-trigger",
      "name": "Cron (daily 02:00 UTC)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL_INTERNAL}}/api/internal/discovery/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Webhook",
              "value": "={{$env.N8N_WEBHOOK_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"sources\": [\"github\",\"reddit\",\"hackernews\",\"producthunt\",\"rss\"]}",
        "options": {
          "timeout": 600000,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 5000
          }
        }
      },
      "id": "trigger-discovery",
      "name": "Trigger Backend Discovery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [520, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL_INTERNAL}}/api/internal/digest/build",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-N8N-Webhook", "value": "={{$env.N8N_WEBHOOK_SECRET}}" }
          ]
        },
        "options": {
          "timeout": 120000,
          "retry": { "maxTries": 2, "waitBetweenTries": 5000 }
        }
      },
      "id": "build-digest",
      "name": "Build Daily Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [800, 300]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "={{$json[\"digest_text\"]}}",
        "additionalFields": {
          "parse_mode": "MarkdownV2",
          "disable_web_page_preview": false
        }
      },
      "id": "send-telegram",
      "name": "Send Telegram Digest",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1080, 300]
    }
  ],
  "connections": {
    "Cron (daily 02:00 UTC)": {
      "main": [[{ "node": "Trigger Backend Discovery", "type": "main", "index": 0 }]]
    },
    "Trigger Backend Discovery": {
      "main": [[{ "node": "Build Daily Digest", "type": "main", "index": 0 }]]
    },
    "Build Daily Digest": {
      "main": [[{ "node": "Send Telegram Digest", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "timezone": "UTC"
  }
}