# =================================================================
# AI Opportunity Radar — Environment Variables
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` to git.
# =================================================================

# ---------- App ----------
APP_NAME=AI Opportunity Radar
APP_ENV=local              # local | dev | staging | prod
APP_DEBUG=true
APP_BASE_URL=http://localhost:3000
APP_API_BASE_URL=http://localhost:8000
# URL the backend uses to call itself when handling Feishu command
# callbacks (incoming event → internal API call). Must use the docker
# service name so the loopback hits this FastAPI process and not the
# ngrok tunnel listener (whose `localhost` is the public endpoint).
FEISHU_INTERNAL_API_URL=http://backend:8000
APP_SECRET_KEY=change-me-in-production
APP_LOG_LEVEL=INFO

# ---------- Mocking ----------
# When true and an API key is missing, services fall back to fixture data.
# Required for local development without paid API access.
MOCK_EXTERNAL_SERVICES=true

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://radar:radar@postgres:5432/radar
DATABASE_URL_SYNC=postgresql://radar:radar@postgres:5432/radar
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND=redis://redis:6379/1

# ---------- LLM Providers ----------
# Primary: MiniMax(MiniMax)。从 https://MiniMax.io 获取 key。
MINIMAX_API_KEY=
MINIMAX_MODEL_CHEAP=MiniMax-M1
MINIMAX_MODEL_MID=MiniMax-M2
MINIMAX_MODEL_STRONG=MiniMax-M3
MINIMAX_API_URL=https://api.MiniMax.io/v1

# Alternative providers(默认不会被选中;只有明确设置 `LLM_DEFAULT_PROVIDER`
# 并填了对应 API Key 才会启用)。
OPENAI_API_KEY=
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_MID=gpt-4o
OPENAI_MODEL_STRONG=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
ANTHROPIC_MODEL_MID=claude-sonnet-5
ANTHROPIC_MODEL_STRONG=claude-opus-5

GEMINI_API_KEY=
GEMINI_MODEL_CHEAP=gemini-1.5-flash
GEMINI_MODEL_MID=gemini-1.5-pro
GEMINI_MODEL_STRONG=gemini-1.5-pro

LLM_DEFAULT_PROVIDER=MiniMax      # MiniMax | openai | anthropic | gemini
LLM_EMBEDDING_MODEL=MiniMax-Embeddings  # MiniMax 嵌入模型;若改用 openai 则换 text-embedding-3-small

# ---------- Firecrawl ----------
# AGPL-3.0 — use hosted API only.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev

# ---------- Browser Use ----------
# Cloud API preferred.
BROWSER_USE_API_KEY=
BROWSER_USE_API_URL=https://api.browser-use.com

# ---------- Deep Research ----------
DEEP_RESEARCH_MAX_URLS=20
DEEP_RESEARCH_MAX_DEPTH=3
DEEP_RESEARCH_MAX_LLM_CALLS=20
DEEP_RESEARCH_MAX_TOKENS=50000

# ---------- Embeddings / Clustering ----------
EMBEDDING_CLUSTER_THRESHOLD=0.82

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ---------- Feishu (Phase 2 v2.0) ----------
# 自定义机器人 Webhook URL,形如:
#   https://open.feishu.cn/open-apis/bot/v2/hook/<your-token>
# 在飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人 拿到。
FEISHU_WEBHOOK_URL=
# 可选:启用"加签"安全设置时填写。空字符串表示不签名。
# 算法: HMAC-SHA256(key=secret, msg="timestamp\nkey"),base64 编码
FEISHU_WEBHOOK_SECRET=
FEISHU_TIMEOUT=15.0

# ---------- Feishu App (Phase 6 v2.0 — 入站事件订阅) ----------
# 在 https://open.feishu.cn 创建"机器人应用"后填入。本地 mock 模式
# 下可全部留空 —— /api/feishu/event 会跳过签名校验。
# 部署到生产时必须填,且用 HTTPS 公网回调地址。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 事件订阅"Verification Token"(URL 验证 + 事件签名)
FEISHU_VERIFICATION_TOKEN=
# 可选:启用"加密传输"时填 AES-256-CBC key (base64 编码)。
# Phase 6 未实现解密,留空即可。
FEISHU_ENCRYPT_KEY=

# ---------- Bot 通道选择 (Phase 6 v2.0) ----------
# 主推送通道: feishu (国内可达 + 知识库 + 权限) | telegram
NOTIFICATION_DEFAULT_CHANNEL=feishu
# 失败时降级顺序: CSV。本字段解析成 list,按顺序尝试,首个成功的为准。
# 默认飞书失败 → 走 Telegram 兜底。
NOTIFICATION_FALLBACK_CHANNELS=telegram

# ---------- n8n ----------
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=
N8N_USER=admin@radar.local
N8N_PASSWORD=change-me
# Shared secret the workflow HTTP nodes send on `X-Radar-Webhook` and our
# backend verifies on `/api/internal/*`. Both sides must agree. Pick a
# long random string in production (e.g. `openssl rand -hex 32`).
RADAR_WEBHOOK_SECRET=dev-secret-change-me

# ---------- CORS ----------
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Rate Limit ----------
RATE_LIMIT_PER_MINUTE=120

# ---------- Sources ----------
# Comma-separated list of enabled source slugs. Empty = all enabled.
ENABLED_SOURCES=github,reddit,hackernews,producthunt,rss

# ---------- Observability (Phase 12) ----------
# Set to false to hide /api/metrics (the middleware still records).
PROMETHEUS_METRICS_ENABLED=true

# ---------- Backups (Phase 12) ----------
# Defaults used by backend/scripts/backup_postgres.sh + restore_postgres.sh.
BACKUP_CONTAINER_NAME=radar-postgres
BACKUP_OUTPUT_DIR=./backups