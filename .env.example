# =================================================================
# AI Opportunity Radar — Environment Variables
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` to git.
# =================================================================

# ---------- App ----------
APP_NAME=AI Opportunity Radar
APP_ENV=local              # local | dev | staging | prod
APP_DEBUG=true
APP_BASE_URL=http://localhost:3000
APP_API_BASE_URL=http://localhost:8000
APP_SECRET_KEY=change-me-in-production
APP_LOG_LEVEL=INFO

# ---------- Mocking ----------
# When true and an API key is missing, services fall back to fixture data.
# Required for local development without paid API access.
MOCK_EXTERNAL_SERVICES=true

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://radar:radar@postgres:5432/radar
DATABASE_URL_SYNC=postgresql://radar:radar@postgres:5432/radar
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND=redis://redis:6379/1

# ---------- LLM Providers ----------
# Provide at least one in production.
OPENAI_API_KEY=
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_MID=gpt-4o
OPENAI_MODEL_STRONG=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
ANTHROPIC_MODEL_MID=claude-sonnet-5
ANTHROPIC_MODEL_STRONG=claude-opus-5

GEMINI_API_KEY=
GEMINI_MODEL_CHEAP=gemini-1.5-flash
GEMINI_MODEL_MID=gemini-1.5-pro
GEMINI_MODEL_STRONG=gemini-1.5-pro

LLM_DEFAULT_PROVIDER=openai      # openai | anthropic | gemini
LLM_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Firecrawl ----------
# AGPL-3.0 — use hosted API only.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev

# ---------- Browser Use ----------
# Cloud API preferred.
BROWSER_USE_API_KEY=
BROWSER_USE_API_URL=https://api.browser-use.com

# ---------- Deep Research ----------
DEEP_RESEARCH_MAX_URLS=20
DEEP_RESEARCH_MAX_DEPTH=3
DEEP_RESEARCH_MAX_LLM_CALLS=20
DEEP_RESEARCH_MAX_TOKENS=50000

# ---------- Embeddings / Clustering ----------
EMBEDDING_CLUSTER_THRESHOLD=0.82

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ---------- n8n ----------
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=
N8N_USER=admin
N8N_PASSWORD=change-me
# Shared secret the workflow HTTP nodes send on `X-Radar-Webhook` and our
# backend verifies on `/api/internal/*`. Both sides must agree. Pick a
# long random string in production (e.g. `openssl rand -hex 32`).
RADAR_WEBHOOK_SECRET=dev-secret-change-me

# ---------- CORS ----------
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Rate Limit ----------
RATE_LIMIT_PER_MINUTE=120

# ---------- Sources ----------
# Comma-separated list of enabled source slugs. Empty = all enabled.
ENABLED_SOURCES=github,reddit,hackernews,producthunt,rss

# ---------- Observability (Phase 12) ----------
# Set to false to hide /api/metrics (the middleware still records).
PROMETHEUS_METRICS_ENABLED=true

# ---------- Backups (Phase 12) ----------
# Defaults used by backend/scripts/backup_postgres.sh + restore_postgres.sh.
BACKUP_CONTAINER_NAME=radar-postgres
BACKUP_OUTPUT_DIR=./backups