# =================================================================
# AI Opportunity Radar — MVP environment variables.
#
# Copy to `.env` and fill in the values. NEVER commit `.env` to git.
#
# The MVP pipeline is:
#   public sources → AI summary → Feishu digest → Feishu bot
#
# Only the env vars required for that flow are listed here. Vars for
# the legacy FREEZE surface (subscriptions, activation, content radar,
# multi-channel fallback, alternative LLM providers, backups, …) were
# removed from this template — see `experimental/backend/.env.example`
# for the pre-MVP list.
# =================================================================


# ---------- App ----------
APP_NAME=AI Opportunity Radar
APP_ENV=local              # local | dev | staging | prod
APP_DEBUG=true
APP_BASE_URL=http://localhost:3000
APP_API_BASE_URL=http://localhost:8000
# URL the backend uses to call itself when handling Feishu command
# callbacks. Must use the docker service name so the loopback hits
# this FastAPI process and not any external tunnel listener.
FEISHU_INTERNAL_API_URL=http://backend:8000
APP_SECRET_KEY=change-me-in-production
APP_LOG_LEVEL=INFO


# ---------- Mocking ----------
# When true and an API key is missing, services fall back to fixture
# data. Required for local development without paid API access.
MOCK_EXTERNAL_SERVICES=true


# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://radar:radar@postgres:5432/radar
DATABASE_URL_SYNC=postgresql://radar:radar@postgres:5432/radar
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20


# ---------- Redis ----------
# Used by the Feishu inbound-event dedupe (F.2 — SETNX idempotency).
REDIS_URL=redis://redis:6379/0


# ---------- LLM (primary provider only) ----------
# Get a key from https://MiniMax.io (Anthropic-compatible endpoint).
MiniMax_API_KEY=
MINIMAX_MODEL_CHEAP=MiniMax-M2.7-highspeed
MINIMAX_MODEL_MID=MiniMax-M2.7
MINIMAX_MODEL_STRONG=MiniMax-M3
MINIMAX_API_URL=https://api.minimaxi.com/anthropic
LLM_DEFAULT_PROVIDER=MiniMax
LLM_EMBEDDING_MODEL=MiniMax-Embeddings


# ---------- Web fetching (used by deep-research step) ----------
# AGPL-3.0 — use the hosted API only.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev

# Cloud API preferred for headless browsing.
BROWSER_USE_API_KEY=
BROWSER_USE_API_URL=https://api.browser-use.com


# ---------- Deep Research ----------
DEEP_RESEARCH_MAX_URLS=20
DEEP_RESEARCH_MAX_DEPTH=3
DEEP_RESEARCH_MAX_LLM_CALLS=20


# ---------- Embeddings / Clustering ----------
EMBEDDING_CLUSTER_THRESHOLD=0.82


# ---------- Feishu outbound (custom robot) ----------
# Webhook URL — create in 飞书群 → 设置 → 群机器人 → 自定义机器人.
#   https://open.feishu.cn/open-apis/bot/v2/hook/<your-token>
FEISHU_WEBHOOK_URL=
# Optional signing secret (加签). Empty = unsigned robot.
FEISHU_WEBHOOK_SECRET=
FEISHU_TIMEOUT=15.0


# ---------- Feishu App (inbound event subscription) ----------
# From https://open.feishu.cn → 创建机器人应用. Leave blank for
# local mock — `/api/feishu/event` will skip signature checks.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# Optional AES-256-CBC key (raw, not base64) when "加密传输" is on.
# Phase 6 v2.0 requires this for parsing `{"encrypt": "..."}` bodies.
FEISHU_ENCRYPT_KEY=


# ---------- Feishu 云文档 (Phase 25 v2.1 — 4 段结构) ----------
# Root folder token. Phase 25 v2.1 places 4 child sections under this
# folder: 📌 首页 / 📅 今日 / 📁 每日报告 / 📚 信息源.
# Open 飞书云盘 → share the target folder → copy the token segment
# from the URL (the part after `/drive/folder/`).
FEISHU_DRIVE_ROOT_FOLDER_TOKEN=
# Multi-dimensional table — 每日报告 index. Leave blank to skip.
FEISHU_BITABLE_APP_TOKEN=
# Multi-dimensional table — Opportunities table. Leave blank to skip.
FEISHU_BITABLE_OPPORTUNITIES_APP_TOKEN=


# ---------- n8n ----------
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=
# Shared secret the workflow HTTP nodes send on `X-Radar-Webhook` and
# our backend verifies on `/api/internal/*`. Pick a long random
# string in production: `openssl rand -hex 32`.
RADAR_WEBHOOK_SECRET=dev-secret-change-me


# ---------- CORS ----------
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ---------- Rate Limit ----------
RATE_LIMIT_PER_MINUTE=120


# ---------- Sources ----------
# Comma-separated. Empty = all built-in connectors enabled.
# v2.1 adds: arxiv, huggingface, douyin, weibo, zhihu, amazon_best,
# wallstreetcn_hot (and 10 new RSS feeds shipped under the `rss` slug).
ENABLED_SOURCES=github,reddit,hackernews,producthunt,rss,arxiv,huggingface,douyin,weibo,zhihu,amazon_best,wallstreetcn_hot


# ---------- Admin (MVP) ----------
# Feishu open_ids allowed to call `/api/admin/*` + the shared secret
# accepted on the `X-Radar-Admin-Secret` header. Empty list disables
# the open-id path; empty secret disables admin entirely.
ADMIN_OPEN_IDS=
ADMIN_API_SECRET=


# ---------- Observability ----------
PROMETHEUS_METRICS_ENABLED=true